# Qraft self-hosted development configuration.
# Run: python3 scripts/configure.py
# This example contains no model configuration or usable instance credentials.
COMPOSE_PROJECT_NAME=qraft
APP_ENV=development
APP_DEV_MODE=true
LOG_LEVEL=info
SOURCE_REVISION=qraft-development

# Local listeners; databases and administrative services stay on loopback.
HTTP_PORT=18180
HTTPS_PORT=18543
API_PORT=18181
FRONTEND_PORT=13100
POSTGRES_PORT=18432
TEMPORAL_DB_PORT=18433
REDIS_PORT=18379
MINIO_API_PORT=19200
MINIO_CONSOLE_PORT=19201
TEMPORAL_PORT=17333
TEMPORAL_UI_PORT=18182
DOMAIN=http://localhost
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_WS_URL=

POSTGRES_USER=qraft
POSTGRES_DB=qraft
POSTGRES_PASSWORD=
TEMPORAL_DB_USER=temporal
TEMPORAL_DB_NAME=temporal
TEMPORAL_DB_PASSWORD=
MINIO_ACCESS_KEY=qraft-admin
MINIO_SECRET_KEY=
MINIO_BUCKET=qraft
JWT_SECRET=
ALGOFORGE_SETTINGS_ENCRYPTION_KEY=

# These compatibility variable names are internal service contracts.
# Models and API keys are configured by the user in the settings UI.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=
ANTHROPIC_PROVIDER=
ALGOFORGE_LLM_API_KEY=
ALGOFORGE_LLM_BASE_URL=
ALGOFORGE_LLM_MODEL=
ALGOFORGE_LLM_PROVIDER=
ALGOFORGE_LLM_REASONING_EFFORT=
ALGOFORGE_LLM_REQUEST_TIMEOUT=30m
ALGOFORGE_EMBEDDING_API_KEY=
ALGOFORGE_EMBEDDING_BASE_URL=
ALGOFORGE_EMBEDDING_MODEL=
ALGOFORGE_EMBEDDING_DIMENSIONS=1536
ALGOFORGE_EMBEDDING_TIMEOUT_SEC=30
# First start exposes the configuration UI only. worker-up enables this after
# validating the user's saved embedding identity.
ALGOFORGE_EMBEDDING_ENABLED=false
# The local configuration UI may connect to the API endpoint entered by the user.
ALGOFORGE_EMBEDDING_UI_ALLOW_PUBLIC=true
ALGOFORGE_EMBEDDING_EXPECTED_STATEMENT_MODEL_VERSION_ID=

ALGOFORGE_CUSTOM_GENERATION_API_MODE=jobs-v1
ALGOFORGE_QG15_EXPORT_MODE=qg15-v1
ALGOFORGE_QUALITY_MODE=quality-v1
ALGOFORGE_S5_DIVERSITY_MODE=diversity-v1
WORKER_CONCURRENCY=10
WORKER_TASK_QUEUE=algoforge-tasks
PROVIDER_EFFECT_LEASE=45m
OUTBOX_ENABLED=false
OUTBOX_ENDPOINT=
OUTBOX_BEARER_TOKEN=
OUTBOX_HMAC_SECRET=

# Filled by configure.py --bind-sandbox after building the sandbox image.
SANDBOX_IMAGE=qraft-sandbox:local
SANDBOX_REVISION=qraft-development
SANDBOX_IMAGE_DIGEST=
SANDBOX_MAX_CONCURRENT=5
SANDBOX_TIME_LIMIT=10
SANDBOX_MEMORY_LIMIT=512
ALGOFORGE_S3_SANDBOX_IMAGE_DIGEST=
ALGOFORGE_S3_SANDBOX_TOOLCHAIN_MANIFEST_DIGEST=
ALGOFORGE_S3_SANDBOX_SECCOMP_POLICY_DIGEST=
ALGOFORGE_S3_HIDDEN_RUNNER_URL=
ALGOFORGE_S3_HIDDEN_RUNNER_BEARER_TOKEN=
